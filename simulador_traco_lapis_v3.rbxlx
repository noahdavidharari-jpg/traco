      <Item class="LocalScript" referent="RBX6">
        <Properties>
          <string name="Name">ClienteHUDLapis</string>
          <ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild(&quot;SimuladorRemotes&quot;)

local ToggleRiscar = Remotes:WaitForChild(&quot;ToggleRiscar&quot;)
local ComprarLapis = Remotes:WaitForChild(&quot;ComprarLapis&quot;)
local ComprarVelocidade = Remotes:WaitForChild(&quot;ComprarVelocidade&quot;)
local AbrirEstojo = Remotes:WaitForChild(&quot;AbrirEstojo&quot;)
local FazerRebirth = Remotes:WaitForChild(&quot;FazerRebirth&quot;)
local DesbloquearArea = Remotes:WaitForChild(&quot;DesbloquearArea&quot;)
local AtualizarHUD = Remotes:WaitForChild(&quot;AtualizarHUD&quot;)
local Notificar = Remotes:WaitForChild(&quot;Notificar&quot;)
local PetSorteado = Remotes:WaitForChild(&quot;PetSorteado&quot;)

-- Construir Interface Moderna (ScreenGui)
local gui = Instance.new(&quot;ScreenGui&quot;)
gui.Name = &quot;SimuladorLapisGUI&quot;
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild(&quot;PlayerGui&quot;)

local function Arredondar(obj, raio)
	local c = Instance.new(&quot;UICorner&quot;)
	c.CornerRadius = UDim.new(0, raio or 12)
	c.Parent = obj
end

local function Borda(obj, cor, espessura)
	local s = Instance.new(&quot;UIStroke&quot;)
	s.Color = cor or Color3.fromRGB(255, 255, 255)
	s.Thickness = espessura or 2
	s.Parent = obj
end

-- Barra Superior de Status e Tinta
local topFrame = Instance.new(&quot;Frame&quot;)
topFrame.Size = UDim2.new(0, 520, 0, 95)
topFrame.Position = UDim2.new(0.5, -260, 0, 14)
topFrame.BackgroundColor3 = Color3.fromRGB(25, 28, 38)
topFrame.BackgroundTransparency = 0.1
topFrame.Parent = gui
Arredondar(topFrame, 14)
Borda(topFrame, Color3.fromRGB(80, 180, 255), 2)

local lblStats = Instance.new(&quot;TextLabel&quot;)
lblStats.Size = UDim2.new(1, -20, 0, 32)
lblStats.Position = UDim2.new(0, 10, 0, 6)
lblStats.BackgroundTransparency = 1
lblStats.Text = &quot;Moedas: 50 | Recorde: 0m | Mult: x1.0&quot;
lblStats.TextColor3 = Color3.fromRGB(255, 230, 90)
lblStats.Font = Enum.Font.GothamBlack
lblStats.TextSize = 17
lblStats.Parent = topFrame

local lblEquipado = Instance.new(&quot;TextLabel&quot;)
lblEquipado.Size = UDim2.new(1, -20, 0, 22)
lblEquipado.Position = UDim2.new(0, 10, 0, 36)
lblEquipado.BackgroundTransparency = 1
lblEquipado.Text = &quot;Lápis Mordido | Área: Caderno de Caligrafia&quot;
lblEquipado.TextColor3 = Color3.fromRGB(210, 225, 255)
lblEquipado.Font = Enum.Font.GothamBold
lblEquipado.TextSize = 14
lblEquipado.Parent = topFrame

local tintaBg = Instance.new(&quot;Frame&quot;)
tintaBg.Size = UDim2.new(1, -24, 0, 22)
tintaBg.Position = UDim2.new(0, 12, 0, 64)
tintaBg.BackgroundColor3 = Color3.fromRGB(15, 17, 24)
tintaBg.Parent = topFrame
Arredondar(tintaBg, 8)

local tintaBar = Instance.new(&quot;Frame&quot;)
tintaBar.Size = UDim2.new(1, 0, 1, 0)
tintaBar.BackgroundColor3 = Color3.fromRGB(0, 220, 140)
tintaBar.Parent = tintaBg
Arredondar(tintaBar, 8)

local lblTinta = Instance.new(&quot;TextLabel&quot;)
lblTinta.Size = UDim2.new(1, 0, 1, 0)
lblTinta.BackgroundTransparency = 1
lblTinta.Text = &quot;TINTA: 100 / 100 (0m)&quot;
lblTinta.TextColor3 = Color3.new(1, 1, 1)
lblTinta.Font = Enum.Font.GothamBlack
lblTinta.TextSize = 13
lblTinta.Parent = tintaBg

-- Notificacao Flutuante
local lblNotif = Instance.new(&quot;TextLabel&quot;)
lblNotif.Size = UDim2.new(0, 560, 0, 36)
lblNotif.Position = UDim2.new(0.5, -280, 0, 116)
lblNotif.BackgroundColor3 = Color3.fromRGB(20, 22, 30)
lblNotif.BackgroundTransparency = 0.25
lblNotif.Text = &quot;Clique em COMEÇAR A RISCAR para testar seu lápis!&quot;
lblNotif.TextColor3 = Color3.fromRGB(120, 255, 180)
lblNotif.Font = Enum.Font.GothamBold
lblNotif.TextSize = 15
lblNotif.Parent = gui
Arredondar(lblNotif, 10)

-- Botao Principal Central Inferior (Riscar / Parar)
local btnRiscar = Instance.new(&quot;TextButton&quot;)
btnRiscar.Size = UDim2.new(0, 310, 0, 58)
btnRiscar.Position = UDim2.new(0.5, -155, 1, -78)
btnRiscar.BackgroundColor3 = Color3.fromRGB(0, 200, 110)
btnRiscar.Text = &quot;COMEÇAR A RISCAR!&quot;
btnRiscar.TextColor3 = Color3.new(1, 1, 1)
btnRiscar.Font = Enum.Font.GothamBlack
btnRiscar.TextSize = 21
btnRiscar.Parent = gui
Arredondar(btnRiscar, 16)
Borda(btnRiscar, Color3.new(1, 1, 1), 2.5)

btnRiscar.MouseButton1Click:Connect(function()
	ToggleRiscar:FireServer()
end)

-- Painel Esquerdo: Evolucoes e Upgrades
local leftPanel = Instance.new(&quot;Frame&quot;)
leftPanel.Size = UDim2.new(0, 225, 0, 310)
leftPanel.Position = UDim2.new(0, 14, 0.5, -155)
leftPanel.BackgroundColor3 = Color3.fromRGB(25, 28, 38)
leftPanel.BackgroundTransparency = 0.12
leftPanel.Parent = gui
Arredondar(leftPanel, 14)
Borda(leftPanel, Color3.fromRGB(255, 185, 60), 2)

local function CriarBotaoMenu(parent, yPos, cor, textoInicial)
	local btn = Instance.new(&quot;TextButton&quot;)
	btn.Size = UDim2.new(1, -20, 0, 64)
	btn.Position = UDim2.new(0, 10, 0, yPos)
	btn.BackgroundColor3 = cor
	btn.Text = textoInicial
	btn.TextColor3 = Color3.new(1, 1, 1)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 13
	btn.TextWrapped = true
	btn.Parent = parent
	Arredondar(btn, 10)
	return btn
end

local btnLapis = CriarBotaoMenu(leftPanel, 12, Color3.fromRGB(230, 125, 30), &quot;EVOLUIR LÁPIS\nCarregando...&quot;)
local btnVel = CriarBotaoMenu(leftPanel, 86, Color3.fromRGB(40, 145, 235), &quot;UPGRADE VELOCIDADE\nNível 1&quot;)
local btnArea = CriarBotaoMenu(leftPanel, 160, Color3.fromRGB(145, 75, 230), &quot;NOVA ÁREA\nCarregando...&quot;)
local btnRebirth = CriarBotaoMenu(leftPanel, 234, Color3.fromRGB(220, 55, 95), &quot;PASSAR DE ANO (Rebirth)\nCusto: 5000&quot;)

btnLapis.MouseButton1Click:Connect(function() ComprarLapis:FireServer() end)
btnVel.MouseButton1Click:Connect(function() ComprarVelocidade:FireServer() end)
btnArea.MouseButton1Click:Connect(function() DesbloquearArea:FireServer() end)
btnRebirth.MouseButton1Click:Connect(function() FazerRebirth:FireServer() end)

-- Painel Direito: Estojos Surpresa (Ovos de Pets)
local rightPanel = Instance.new(&quot;Frame&quot;)
rightPanel.Size = UDim2.new(0, 225, 0, 255)
rightPanel.Position = UDim2.new(1, -239, 0.5, -128)
rightPanel.BackgroundColor3 = Color3.fromRGB(25, 28, 38)
rightPanel.BackgroundTransparency = 0.12
rightPanel.Parent = gui
Arredondar(rightPanel, 14)
Borda(rightPanel, Color3.fromRGB(0, 230, 180), 2)

local titlePets = Instance.new(&quot;TextLabel&quot;)
titlePets.Size = UDim2.new(1, 0, 0, 32)
titlePets.BackgroundTransparency = 1
titlePets.Text = &quot;ESTOJOS DE PETS&quot;
titlePets.TextColor3 = Color3.fromRGB(0, 240, 190)
titlePets.Font = Enum.Font.GothamBlack
titlePets.TextSize = 15
titlePets.Parent = rightPanel

local btnEstojo1 = CriarBotaoMenu(rightPanel, 38, Color3.fromRGB(35, 175, 130), &quot;ABRIR ESTOJO ESCOLAR\nCusto: 100 Moedas&quot;)
local btnEstojo2 = CriarBotaoMenu(rightPanel, 110, Color3.fromRGB(120, 60, 210), &quot;ABRIR ESTOJO CÓSMICO\nCusto: 2.500 Moedas&quot;)

local lblPetsAtivos = Instance.new(&quot;TextLabel&quot;)
lblPetsAtivos.Size = UDim2.new(1, -16, 0, 65)
lblPetsAtivos.Position = UDim2.new(0, 8, 0, 182)
lblPetsAtivos.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
lblPetsAtivos.Text = &quot;Pets Equipados: Nenhum&quot;
lblPetsAtivos.TextColor3 = Color3.fromRGB(220, 220, 235)
lblPetsAtivos.Font = Enum.Font.Gotham
lblPetsAtivos.TextSize = 12
lblPetsAtivos.TextWrapped = true
lblPetsAtivos.Parent = rightPanel
Arredondar(lblPetsAtivos, 8)

btnEstojo1.MouseButton1Click:Connect(function() AbrirEstojo:FireServer(1) end)
btnEstojo2.MouseButton1Click:Connect(function() AbrirEstojo:FireServer(2) end)

-- Popup Animado de Sorteio de Pet
local popupPet = Instance.new(&quot;Frame&quot;)
popupPet.Size = UDim2.new(0, 340, 0, 140)
popupPet.Position = UDim2.new(0.5, -170, 0.35, -70)
popupPet.BackgroundColor3 = Color3.fromRGB(30, 25, 55)
popupPet.Visible = false
popupPet.Parent = gui
Arredondar(popupPet, 18)
Borda(popupPet, Color3.fromRGB(255, 220, 80), 3)

local lblPopup = Instance.new(&quot;TextLabel&quot;)
lblPopup.Size = UDim2.new(1, -20, 1, -20)
lblPopup.Position = UDim2.new(0, 10, 0, 10)
lblPopup.BackgroundTransparency = 1
lblPopup.Text = &quot;NOVO PET!&quot;
lblPopup.TextColor3 = Color3.new(1, 1, 1)
lblPopup.Font = Enum.Font.GothamBlack
lblPopup.TextSize = 19
lblPopup.TextWrapped = true
lblPopup.Parent = popupPet

PetSorteado.OnClientEvent:Connect(function(nome, raridade, mult)
	lblPopup.Text = &quot;ESTOJO ABERTO!\n[&quot; .. string.upper(raridade) .. &quot;]\n&quot; .. nome .. &quot; (x&quot; .. mult .. &quot; Moedas)&quot;
	popupPet.Visible = true
	popupPet.Size = UDim2.new(0, 100, 0, 40)
	local tw = TweenService:Create(popupPet, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Size = UDim2.new(0, 340, 0, 140)})
	tw:Play()
	task.delay(2.8, function()
		popupPet.Visible = false
	end)
end)

Notificar.OnClientEvent:Connect(function(msg)
	lblNotif.Text = msg
end)

AtualizarHUD.OnClientEvent:Connect(function(dados)
	lblStats.Text = &quot;Moedas: &quot; .. dados.Moedas .. &quot; | Recorde: &quot; .. dados.Recorde .. &quot;m | Mult: x&quot; .. dados.MultTotal
	lblEquipado.Text = dados.LapisNome .. &quot; (Ano &quot; .. dados.Rebirths .. &quot;) | Área: &quot; .. dados.AreaNome

	local pct = math.clamp(dados.TintaAtual / math.max(1, dados.TintaMax), 0, 1)
	tintaBar.Size = UDim2.new(pct, 0, 1, 0)
	tintaBar.BackgroundColor3 = (pct &gt; 0.3) and Color3.fromRGB(0, 220, 140) or Color3.fromRGB(255, 75, 75)
	lblTinta.Text = &quot;TINTA: &quot; .. math.floor(dados.TintaAtual) .. &quot; / &quot; .. dados.TintaMax .. &quot; (&quot; .. math.floor(dados.DistanciaAtual) .. &quot;m)&quot;

	if dados.Riscando then
		btnRiscar.BackgroundColor3 = Color3.fromRGB(235, 65, 65)
		btnRiscar.Text = &quot;PARAR E COLETAR MOEDAS&quot;
	else
		btnRiscar.BackgroundColor3 = Color3.fromRGB(0, 200, 110)
		btnRiscar.Text = &quot;COMEÇAR A RISCAR!&quot;
	end

	if dados.ProxLapisCusto &gt; 0 then
		btnLapis.Text = &quot;EVOLUIR LÁPIS\n&quot; .. dados.ProxLapisNome .. &quot; (&quot; .. dados.ProxLapisCusto .. &quot; Moedas)&quot;
	else
		btnLapis.Text = &quot;LÁPIS NO NÍVEL MÁXIMO!&quot;
	end

	btnVel.Text = &quot;UPGRADE VELOCIDADE (Nv.&quot; .. dados.VelocidadeNivel .. &quot;)\nCusto: &quot; .. dados.VelocidadeCusto .. &quot; Moedas&quot;

	if dados.ProxAreaCusto &gt; 0 then
		btnArea.Text = &quot;DESBLOQUEAR ÁREA\n&quot; .. dados.ProxAreaNome .. &quot; (&quot; .. dados.ProxAreaCusto .. &quot; Moedas)&quot;
	else
		btnArea.Text = &quot;TODAS AS ÁREAS ABERTAS!&quot;
	end

	btnRebirth.Text = &quot;PASSAR DE ANO (Rebirth #&quot; .. (dados.Rebirths + 1) .. &quot;)\nCusto: &quot; .. dados.RebirthCusto .. &quot; Moedas&quot;

	if #dados.Pets &gt; 0 then
		local lista = {}
		for _, p in ipairs(dados.Pets) do
			table.insert(lista, p.Nome .. &quot; (x&quot; .. p.Mult .. &quot;)&quot;)
		end
		lblPetsAtivos.Text = &quot;Equipados: &quot; .. table.concat(lista, &quot;, &quot;)
	else
		lblPetsAtivos.Text = &quot;Pets Equipados: Nenhum&quot;
	end
end)
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
