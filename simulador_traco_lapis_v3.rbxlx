  <Item class="ServerScriptService" referent="RBX2">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="RBX3">
      <Properties>
        <string name="Name">SistemaSimuladorLapis</string>
        <ProtectedString name="Source">local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Debris = game:GetService(&quot;Debris&quot;)

-- Criar RemoteEvents e RemoteFunctions
local Remotes = Instance.new(&quot;Folder&quot;)
Remotes.Name = &quot;SimuladorRemotes&quot;
Remotes.Parent = ReplicatedStorage

local ToggleRiscar = Instance.new(&quot;RemoteEvent&quot;)
ToggleRiscar.Name = &quot;ToggleRiscar&quot;
ToggleRiscar.Parent = Remotes

local ComprarLapis = Instance.new(&quot;RemoteEvent&quot;)
ComprarLapis.Name = &quot;ComprarLapis&quot;
ComprarLapis.Parent = Remotes

local ComprarVelocidade = Instance.new(&quot;RemoteEvent&quot;)
ComprarVelocidade.Name = &quot;ComprarVelocidade&quot;
ComprarVelocidade.Parent = Remotes

local AbrirEstojo = Instance.new(&quot;RemoteEvent&quot;)
AbrirEstojo.Name = &quot;AbrirEstojo&quot;
AbrirEstojo.Parent = Remotes

local FazerRebirth = Instance.new(&quot;RemoteEvent&quot;)
FazerRebirth.Name = &quot;FazerRebirth&quot;
FazerRebirth.Parent = Remotes

local DesbloquearArea = Instance.new(&quot;RemoteEvent&quot;)
DesbloquearArea.Name = &quot;DesbloquearArea&quot;
DesbloquearArea.Parent = Remotes

local AtualizarHUD = Instance.new(&quot;RemoteEvent&quot;)
AtualizarHUD.Name = &quot;AtualizarHUD&quot;
AtualizarHUD.Parent = Remotes

local Notificar = Instance.new(&quot;RemoteEvent&quot;)
Notificar.Name = &quot;Notificar&quot;
Notificar.Parent = Remotes

local PetSorteado = Instance.new(&quot;RemoteEvent&quot;)
PetSorteado.Name = &quot;PetSorteado&quot;
PetSorteado.Parent = Remotes

-- Configuracoes do Jogo
local LapisLista = {
	{Nome = &quot;Lápis Mordido&quot;, Custo = 0, TintaMax = 100, Consumo = 8, Mult = 1.0, Largura = 0.6, Cor = Color3.fromRGB(255, 200, 60)},
	{Nome = &quot;Lápis Escolar HB&quot;, Custo = 60, TintaMax = 180, Consumo = 7.5, Mult = 1.6, Largura = 0.9, Cor = Color3.fromRGB(255, 170, 0)},
	{Nome = &quot;Lápis de Cor Neon&quot;, Custo = 220, TintaMax = 300, Consumo = 7.0, Mult = 2.8, Largura = 1.2, Cor = Color3.fromRGB(0, 255, 170)},
	{Nome = &quot;Lapiseira Técnica&quot;, Custo = 750, TintaMax = 500, Consumo = 6.5, Mult = 5.0, Largura = 1.5, Cor = Color3.fromRGB(0, 170, 255)},
	{Nome = &quot;Caneta Esferográfica&quot;, Custo = 2200, TintaMax = 800, Consumo = 6.0, Mult = 9.0, Largura = 1.9, Cor = Color3.fromRGB(80, 100, 255)},
	{Nome = &quot;Marca-Texto Radioativo&quot;, Custo = 6500, TintaMax = 1300, Consumo = 5.5, Mult = 16.0, Largura = 2.4, Cor = Color3.fromRGB(170, 255, 0)},
	{Nome = &quot;Caneta Tinteiro Ouro&quot;, Custo = 20000, TintaMax = 2100, Consumo = 5.0, Mult = 30.0, Largura = 3.0, Cor = Color3.fromRGB(255, 215, 0)},
	{Nome = &quot;Caneta Cósmica&quot;, Custo = 65000, TintaMax = 3500, Consumo = 4.2, Mult = 60.0, Largura = 3.8, Cor = Color3.fromRGB(220, 60, 255)}
}

local EstojosLista = {
	[1] = {
		Nome = &quot;Estojo Escolar&quot;,
		Custo = 100,
		Pets = {
			{Nome = &quot;Borracha Saltitante&quot;, Raridade = &quot;Comum&quot;, Chance = 55, Mult = 1.3, Cor = Color3.fromRGB(255, 140, 160), Forma = Enum.PartType.Block},
			{Nome = &quot;Apontador Azul&quot;, Raridade = &quot;Raro&quot;, Chance = 30, Mult = 1.8, Cor = Color3.fromRGB(70, 170, 255), Forma = Enum.PartType.Cylinder},
			{Nome = &quot;Clipe de Prata&quot;, Raridade = &quot;Épico&quot;, Chance = 12, Mult = 2.8, Cor = Color3.fromRGB(210, 220, 235), Forma = Enum.PartType.Ball},
			{Nome = &quot;Régua Dourada&quot;, Raridade = &quot;Lendário&quot;, Chance = 3, Mult = 5.0, Cor = Color3.fromRGB(255, 215, 0), Forma = Enum.PartType.Block}
		}
	},
	[2] = {
		Nome = &quot;Estojo Cósmico&quot;,
		Custo = 2500,
		Pets = {
			{Nome = &quot;Caneta Gel Neon&quot;, Raridade = &quot;Comum&quot;, Chance = 50, Mult = 3.5, Cor = Color3.fromRGB(0, 255, 180), Forma = Enum.PartType.Cylinder},
			{Nome = &quot;Compasso Estelar&quot;, Raridade = &quot;Raro&quot;, Chance = 32, Mult = 6.0, Cor = Color3.fromRGB(140, 100, 255), Forma = Enum.PartType.Ball},
			{Nome = &quot;Borracha Quântica&quot;, Raridade = &quot;Épico&quot;, Chance = 14, Mult = 11.0, Cor = Color3.fromRGB(255, 60, 200), Forma = Enum.PartType.Block},
			{Nome = &quot;Tinteiro Galáctico&quot;, Raridade = &quot;Lendário&quot;, Chance = 4, Mult = 22.0, Cor = Color3.fromRGB(255, 240, 100), Forma = Enum.PartType.Ball}
		}
	}
}

local AreasLista = {
	{Nome = &quot;Caderno de Caligrafia&quot;, Custo = 0, Mult = 1.0, ZStart = 0},
	{Nome = &quot;Folha Quadriculada&quot;, Custo = 350, Mult = 2.5, ZStart = -320},
	{Nome = &quot;Cartolina Neon&quot;, Custo = 2500, Mult = 6.0, ZStart = -640},
	{Nome = &quot;Pergaminho Dourado&quot;, Custo = 15000, Mult = 15.0, ZStart = -960}
}

local PlayerDados = {}

local function CalcularCustoVelocidade(nivel)
	return math.floor(40 * (1.45 ^ (nivel - 1)))
end

local function CalcularCustoRebirth(rebirths)
	return math.floor(5000 * (2.5 ^ rebirths))
end

local function AtualizarVisualLapis(player)
	local dados = PlayerDados[player.UserId]
	if not dados then return end
	local char = player.Character
	if not char then return end

	local oldTool = char:FindFirstChild(&quot;LapisEquipado&quot;) or player.Backpack:FindFirstChild(&quot;LapisEquipado&quot;)
	if oldTool then oldTool:Destroy() end

	local info = LapisLista[dados.LapisNivel]
	local modelo = Instance.new(&quot;Part&quot;)
	modelo.Name = &quot;LapisEquipado&quot;
	modelo.Size = Vector3.new(0.45 + dados.LapisNivel * 0.08, 0.45 + dados.LapisNivel * 0.08, 3.2 + dados.LapisNivel * 0.35)
	modelo.Color = info.Cor
	modelo.Material = (dados.LapisNivel &gt;= 6) and Enum.Material.Neon or Enum.Material.SmoothPlastic
	modelo.CanCollide = false
	modelo.Massless = true

	local ponta = Instance.new(&quot;Part&quot;)
	ponta.Name = &quot;Ponta&quot;
	ponta.Size = Vector3.new(0.35, 0.35, 0.7)
	ponta.Color = Color3.fromRGB(30, 30, 35)
	ponta.Material = Enum.Material.Neon
	ponta.CanCollide = false
	ponta.Massless = true
	ponta.Parent = modelo

	local weldPonta = Instance.new(&quot;WeldConstraint&quot;)
	weldPonta.Part0 = modelo
	weldPonta.Part1 = ponta
	weldPonta.Parent = ponta

	local hand = char:FindFirstChild(&quot;RightHand&quot;) or char:FindFirstChild(&quot;Right Arm&quot;)
	if hand then
		modelo.CFrame = hand.CFrame * CFrame.new(0, -0.5, -1.2) * CFrame.Angles(math.rad(-55), 0, 0)
		ponta.CFrame = modelo.CFrame * CFrame.new(0, 0, -(modelo.Size.Z / 2 + 0.3))
		modelo.Parent = char
		local weld = Instance.new(&quot;WeldConstraint&quot;)
		weld.Part0 = hand
		weld.Part1 = modelo
		weld.Parent = modelo
	end
end

local function AtualizarVisualPets(player)
	local dados = PlayerDados[player.UserId]
	if not dados then return end
	local char = player.Character
	if not char then return end

	local oldFolder = char:FindFirstChild(&quot;PetsAtivos&quot;)
	if oldFolder then oldFolder:Destroy() end

	local folder = Instance.new(&quot;Folder&quot;)
	folder.Name = &quot;PetsAtivos&quot;
	folder.Parent = char

	for i, pet in ipairs(dados.MelhoresPets) do
		local p = Instance.new(&quot;Part&quot;)
		p.Name = &quot;Pet_&quot; .. i
		p.Shape = pet.Forma or Enum.PartType.Block
		p.Size = Vector3.new(1.5, 1.5, 1.5)
		p.Color = pet.Cor
		p.Material = Enum.Material.Neon
		p.CanCollide = false
		p.Anchored = true
		p.Parent = folder

		local bb = Instance.new(&quot;BillboardGui&quot;)
		bb.Size = UDim2.new(0, 120, 0, 36)
		bb.StudsOffset = Vector3.new(0, 1.6, 0)
		bb.AlwaysOnTop = true
		bb.Parent = p

		local lbl = Instance.new(&quot;TextLabel&quot;)
		lbl.Size = UDim2.new(1, 0, 1, 0)
		lbl.BackgroundTransparency = 1
		lbl.Text = pet.Nome .. &quot; (x&quot; .. pet.Mult .. &quot;)&quot;
		lbl.TextColor3 = Color3.new(1, 1, 1)
		lbl.TextStrokeTransparency = 0.3
		lbl.Font = Enum.Font.GothamBold
		lbl.TextScaled = true
		lbl.Parent = bb
	end
end

local function CalcularMultPets(dados)
	local total = 1.0
	for _, pet in ipairs(dados.MelhoresPets) do
		total = total + (pet.Mult - 1.0)
	end
	return total
end

local function EnviarEstado(player)
	local dados = PlayerDados[player.UserId]
	if not dados then return end

	local infoLapis = LapisLista[dados.LapisNivel]
	local proxLapis = LapisLista[dados.LapisNivel + 1]
	local infoArea = AreasLista[dados.AreaAtual]
	local proxArea = AreasLista[dados.AreaAtual + 1]

	local pacote = {
		Moedas = dados.Moedas,
		Recorde = dados.Recorde,
		Rebirths = dados.Rebirths,
		Riscando = dados.Riscando,
		TintaAtual = dados.TintaAtual,
		TintaMax = infoLapis.TintaMax,
		DistanciaAtual = dados.DistanciaAtual,
		LapisNome = infoLapis.Nome,
		LapisNivel = dados.LapisNivel,
		ProxLapisNome = proxLapis and proxLapis.Nome or &quot;MÁXIMO&quot;,
		ProxLapisCusto = proxLapis and proxLapis.Custo or 0,
		VelocidadeNivel = dados.VelocidadeNivel,
		VelocidadeCusto = CalcularCustoVelocidade(dados.VelocidadeNivel),
		AreaNome = infoArea.Nome,
		AreaNivel = dados.AreaAtual,
		ProxAreaNome = proxArea and proxArea.Nome or &quot;TODAS ABERTAS&quot;,
		ProxAreaCusto = proxArea and proxArea.Custo or 0,
		RebirthCusto = CalcularCustoRebirth(dados.Rebirths),
		MultTotal = string.format(&quot;%.1f&quot;, infoLapis.Mult * infoArea.Mult * CalcularMultPets(dados) * (1 + dados.Rebirths * 0.75)),
		Pets = dados.MelhoresPets
	}
	AtualizarHUD:FireClient(player, pacote)
end

local function FinalizarRisco(player, motivo)
	local dados = PlayerDados[player.UserId]
	if not dados or not dados.Riscando then return end

	dados.Riscando = false
	local infoLapis = LapisLista[dados.LapisNivel]
	local infoArea = AreasLista[dados.AreaAtual]
	local multPets = CalcularMultPets(dados)
	local multRebirth = 1 + (dados.Rebirths * 0.75)

	local dist = math.floor(dados.DistanciaAtual)
	local ganho = math.floor(dist * 0.6 * infoLapis.Mult * infoArea.Mult * multPets * multRebirth)

	dados.Moedas = dados.Moedas + ganho
	if dist &gt; dados.Recorde then
		dados.Recorde = dist
	end

	local ls = player:FindFirstChild(&quot;leaderstats&quot;)
	if ls then
		ls.Moedas.Value = dados.Moedas
		ls.Recorde.Value = dados.Recorde
		ls.Rebirths.Value = dados.Rebirths
	end

	dados.TintaAtual = infoLapis.TintaMax
	dados.DistanciaAtual = 0
	dados.UltimoPonto = nil

	local char = player.Character
	if char and char:FindFirstChild(&quot;HumanoidRootPart&quot;) then
		char.HumanoidRootPart.CFrame = CFrame.new(0, 5, AreasLista[dados.AreaAtual].ZStart + 15)
	end

	Notificar:FireClient(player, motivo .. &quot; Você riscou &quot; .. dist .. &quot;m e ganhou +&quot; .. ganho .. &quot; Moedas!&quot;)
	EnviarEstado(player)
end

ToggleRiscar.OnServerEvent:Connect(function(player)
	local dados = PlayerDados[player.UserId]
	if not dados then return end

	if dados.Riscando then
		FinalizarRisco(player, &quot;Traço finalizado!&quot;)
	else
		local infoLapis = LapisLista[dados.LapisNivel]
		dados.Riscando = true
		dados.TintaAtual = infoLapis.TintaMax
		dados.DistanciaAtual = 0
		dados.UltimoPonto = nil

		local char = player.Character
		if char and char:FindFirstChild(&quot;HumanoidRootPart&quot;) then
			local zIni = AreasLista[dados.AreaAtual].ZStart - 10
			char.HumanoidRootPart.CFrame = CFrame.new(0, 5, zIni)
			dados.UltimoPonto = Vector3.new(0, 0.6, zIni)
		end
		Notificar:FireClient(player, &quot;Corra pela pista para riscar o mais longe possível!&quot;)
		EnviarEstado(player)
	end
end)

ComprarLapis.OnServerEvent:Connect(function(player)
	local dados = PlayerDados[player.UserId]
	if not dados or dados.Riscando then return end
	local prox = LapisLista[dados.LapisNivel + 1]
	if not prox then
		Notificar:FireClient(player, &quot;Você já possui a Caneta Cósmica máxima!&quot;)
		return
	end
	if dados.Moedas &gt;= prox.Custo then
		dados.Moedas = dados.Moedas - prox.Custo
		dados.LapisNivel = dados.LapisNivel + 1
		dados.TintaAtual = prox.TintaMax
		player.leaderstats.Moedas.Value = dados.Moedas
		AtualizarVisualLapis(player)
		Notificar:FireClient(player, &quot;Evoluiu para: &quot; .. prox.Nome .. &quot;!&quot;)
		EnviarEstado(player)
	else
		Notificar:FireClient(player, &quot;Moedas insuficientes para evoluir o lápis!&quot;)
	end
end)

ComprarVelocidade.OnServerEvent:Connect(function(player)
	local dados = PlayerDados[player.UserId]
	if not dados then return end
	local custo = CalcularCustoVelocidade(dados.VelocidadeNivel)
	if dados.Moedas &gt;= custo then
		dados.Moedas = dados.Moedas - custo
		dados.VelocidadeNivel = dados.VelocidadeNivel + 1
		player.leaderstats.Moedas.Value = dados.Moedas
		local char = player.Character
		if char and char:FindFirstChild(&quot;Humanoid&quot;) then
			char.Humanoid.WalkSpeed = 18 + (dados.VelocidadeNivel * 2.2)
		end
		Notificar:FireClient(player, &quot;Velocidade aumentada para Nível &quot; .. dados.VelocidadeNivel .. &quot;!&quot;)
		EnviarEstado(player)
	else
		Notificar:FireClient(player, &quot;Moedas insuficientes para melhorar a velocidade!&quot;)
	end
end)

DesbloquearArea.OnServerEvent:Connect(function(player)
	local dados = PlayerDados[player.UserId]
	if not dados or dados.Riscando then return end
	local prox = AreasLista[dados.AreaAtual + 1]
	if not prox then
		Notificar:FireClient(player, &quot;Todas as áreas já foram desbloqueadas!&quot;)
		return
	end
	if dados.Moedas &gt;= prox.Custo then
		dados.Moedas = dados.Moedas - prox.Custo
		dados.AreaAtual = dados.AreaAtual + 1
		player.leaderstats.Moedas.Value = dados.Moedas
		local char = player.Character
		if char and char:FindFirstChild(&quot;HumanoidRootPart&quot;) then
			char.HumanoidRootPart.CFrame = CFrame.new(0, 5, prox.ZStart + 15)
		end
		Notificar:FireClient(player, &quot;Área desbloqueada: &quot; .. prox.Nome .. &quot; (x&quot; .. prox.Mult .. &quot; Moedas)!&quot;)
		EnviarEstado(player)
	else
		Notificar:FireClient(player, &quot;Moedas insuficientes para desbloquear esta área!&quot;)
	end
end)

AbrirEstojo.OnServerEvent:Connect(function(player, tipoEstojo)
	local dados = PlayerDados[player.UserId]
	if not dados then return end
	local estojo = EstojosLista[tipoEstojo or 1]
	if not estojo then return end

	if dados.Moedas &lt; estojo.Custo then
		Notificar:FireClient(player, &quot;Você precisa de &quot; .. estojo.Custo .. &quot; Moedas para abrir o &quot; .. estojo.Nome .. &quot;!&quot;)
		return
	end

	dados.Moedas = dados.Moedas - estojo.Custo
	player.leaderstats.Moedas.Value = dados.Moedas

	local roll = math.random(1, 100)
	local acumulado = 0
	local escolhido = estojo.Pets[1]
	for _, pet in ipairs(estojo.Pets) do
		acumulado = acumulado + pet.Chance
		if roll &lt;= acumulado then
			escolhido = pet
			break
		end
	end

	table.insert(dados.MelhoresPets, {
		Nome = escolhido.Nome,
		Raridade = escolhido.Raridade,
		Mult = escolhido.Mult,
		Cor = escolhido.Cor,
		Forma = escolhido.Forma
	})

	table.sort(dados.MelhoresPets, function(a, b)
		return a.Mult &gt; b.Mult
	end)

	while #dados.MelhoresPets &gt; 3 do
		table.remove(dados.MelhoresPets)
	end

	AtualizarVisualPets(player)
	PetSorteado:FireClient(player, escolhido.Nome, escolhido.Raridade, escolhido.Mult)
	EnviarEstado(player)
end)

FazerRebirth.OnServerEvent:Connect(function(player)
	local dados = PlayerDados[player.UserId]
	if not dados or dados.Riscando then return end
	local custo = CalcularCustoRebirth(dados.Rebirths)
	if dados.Moedas &gt;= custo then
		dados.Moedas = 0
		dados.LapisNivel = 1
		dados.VelocidadeNivel = 1
		dados.AreaAtual = 1
		dados.Rebirths = dados.Rebirths + 1
		dados.TintaAtual = LapisLista[1].TintaMax

		player.leaderstats.Moedas.Value = 0
		player.leaderstats.Rebirths.Value = dados.Rebirths

		local char = player.Character
		if char then
			if char:FindFirstChild(&quot;Humanoid&quot;) then
				char.Humanoid.WalkSpeed = 20
			end
			if char:FindFirstChild(&quot;HumanoidRootPart&quot;) then
				char.HumanoidRootPart.CFrame = CFrame.new(0, 5, 15)
			end
		end
		AtualizarVisualLapis(player)
		Notificar:FireClient(player, &quot;PASSOU DE ANO (Rebirth #&quot; .. dados.Rebirths .. &quot;)! Bônus permanente de +75% por ano!&quot;)
		EnviarEstado(player)
	else
		Notificar:FireClient(player, &quot;Você precisa de &quot; .. custo .. &quot; Moedas para Passar de Ano!&quot;)
	end
end)

Players.PlayerAdded:Connect(function(player)
	local ls = Instance.new(&quot;Folder&quot;)
	ls.Name = &quot;leaderstats&quot;
	ls.Parent = player

	local moedas = Instance.new(&quot;IntValue&quot;)
	moedas.Name = &quot;Moedas&quot;
	moedas.Value = 50
	moedas.Parent = ls

	local recorde = Instance.new(&quot;IntValue&quot;)
	recorde.Name = &quot;Recorde&quot;
	recorde.Value = 0
	recorde.Parent = ls

	local rebirths = Instance.new(&quot;IntValue&quot;)
	rebirths.Name = &quot;Rebirths&quot;
	rebirths.Value = 0
	rebirths.Parent = ls

	PlayerDados[player.UserId] = {
		Moedas = 50,
		Recorde = 0,
		Rebirths = 0,
		LapisNivel = 1,
		VelocidadeNivel = 1,
		AreaAtual = 1,
		Riscando = false,
		TintaAtual = 100,
		DistanciaAtual = 0,
		UltimoPonto = nil,
		MelhoresPets = {}
	}

	player.CharacterAdded:Connect(function(char)
		task.wait(0.3)
		local dados = PlayerDados[player.UserId]
		if dados and char:FindFirstChild(&quot;Humanoid&quot;) then
			char.Humanoid.WalkSpeed = 18 + (dados.VelocidadeNivel * 2.2)
		end
		AtualizarVisualLapis(player)
		AtualizarVisualPets(player)
		EnviarEstado(player)
	end)
end)

Players.PlayerRemoving:Connect(function(player)
	PlayerDados[player.UserId] = nil
end)

-- Loop Principal de Riscar e Animacao dos Pets
task.spawn(function()
	local dt = 0.08
	local angulo = 0
	while true do
		task.wait(dt)
		angulo = angulo + 0.12
		for _, player in ipairs(Players:GetPlayers()) do
			local dados = PlayerDados[player.UserId]
			local char = player.Character
			local hrp = char and char:FindFirstChild(&quot;HumanoidRootPart&quot;)

			if dados and hrp then
				-- Animar Pets ao redor do jogador
				local folderPets = char:FindFirstChild(&quot;PetsAtivos&quot;)
				if folderPets then
					for i, p in ipairs(folderPets:GetChildren()) do
						local offsetAngle = angulo + (i * 2.1)
						local targetPos = hrp.Position + Vector3.new(math.cos(offsetAngle) * 3.8, 1.5 + math.sin(angulo * 2 + i) * 0.4, math.sin(offsetAngle) * 3.8)
						p.CFrame = CFrame.new(targetPos) * CFrame.Angles(0, -offsetAngle, 0)
					end
				end

				-- Logica de Riscar Linha
				if dados.Riscando then
					local infoLapis = LapisLista[dados.LapisNivel]
					local posAtual = Vector3.new(hrp.Position.X, 0.55, hrp.Position.Z)

					if dados.UltimoPonto then
						local distTrecho = (posAtual - dados.UltimoPonto).Magnitude
						if distTrecho &gt; 0.6 then
							dados.DistanciaAtual = dados.DistanciaAtual + distTrecho
							local gastoTinta = distTrecho * (infoLapis.Consumo * 0.14)
							dados.TintaAtual = math.max(0, dados.TintaAtual - gastoTinta)

							-- Criar segmento fisico da linha riscada no chao
							local traco = Instance.new(&quot;Part&quot;)
							traco.Name = &quot;TracoRiscado&quot;
							traco.Anchored = true
							traco.CanCollide = false
							traco.Material = Enum.Material.Neon
							traco.Color = infoLapis.Cor
							traco.Size = Vector3.new(infoLapis.Largura, 0.18, distTrecho + 0.35)
							local meio = (dados.UltimoPonto + posAtual) / 2
							traco.CFrame = CFrame.lookAt(meio, posAtual)
							traco.Parent = workspace
							Debris:AddItem(traco, 14)

							dados.UltimoPonto = posAtual
						else
							-- Consumo minimo parado para incentivar movimento
							dados.TintaAtual = math.max(0, dados.TintaAtual - (dt * 2.0))
						end
					else
						dados.UltimoPonto = posAtual
					end

					if dados.TintaAtual &lt;= 0 then
						FinalizarRisco(player, &quot;Acabou a tinta!&quot;)
					else
						EnviarEstado(player)
					end
				end
			end
		end
	end
end)
